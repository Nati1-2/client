# Event Organizer - Client Environment Variables for Vercel
# In Vercel Project Settings -> Environment Variables, add the following:

# 1. URL to your deployed backend API (e.g. deployed on Render, Railway, Koyeb, etc.)
# Leave empty if you are using vercel.json rewrites
REACT_APP_API_URL=https://your-backend-service.onrender.com

# 2. Prevent Vercel build from failing on harmless ESLint warnings
CI=false

# 3. Disable production source maps for faster builds and privacy
GENERATE_SOURCEMAP=false
